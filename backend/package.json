{
  "name": "quince-gear-sn-backend",
  "version": "1.0.0",
  "description": "Backend e-commerce Quince Gear SN",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "node scripts/guard-prisma.js generate --schema=prisma/schema.prisma",
    "prisma:migrate": "node scripts/guard-prisma.js migrate dev --schema=prisma/schema.prisma",
    "prisma:deploy": "node scripts/guard-prisma.js migrate deploy --schema=prisma/schema.prisma",
    "prisma:status": "node scripts/guard-prisma.js migrate status --schema=prisma/schema.prisma",
    "prisma:push": "node scripts/guard-prisma.js db push --schema=prisma/schema.prisma",
    "prisma:reset": "node scripts/guard-prisma.js migrate reset --schema=prisma/schema.prisma",
    "prisma:studio": "node scripts/guard-prisma.js studio --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.110.2",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "pdfkit": "^0.19.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "prisma": "^5.20.0"
  }
}
